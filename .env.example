# 이 파일을 .env 로 복사하고 값을 채운다(.env는 .gitignore 대상 — 커밋되지 않는다).
#   cp .env.example .env
# 의도 힌트 A/B(scripts/intent_ab.sh)에는 둘 중 하나면 된다. 둘 다 있으면 OPENAI_API_KEY(직접)를 쓴다.
#   OPENAI_API_KEY: 상담원 LLM gpt-5.4-mini + 응대 채점 gpt-5.5(공식 채점과 같은 경로)
#   BAZE_API_KEY:   대회 게이트웨이로 상담원 LLM + 응대 채점
OPENAI_API_KEY=
BAZE_API_KEY=
# 음성 전체 측정(공식 run_eval.py)·제출용 — A/B에는 필요 없다
# SONIOX_API_KEY=
# GEMINI_API_KEY=
